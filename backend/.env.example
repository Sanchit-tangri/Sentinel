# ==============================================================================
# Sentinel Backend Environment Configuration
# ==============================================================================

# OmniRoute Configuration
# If left blank, Sentinel runs in intelligent simulation mode (zero cost, simulated switches)
OMNIROUTE_API_KEY=your_omniroute_or_openai_api_key_here
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# Optional: Port and Host Configuration
PORT=8000
HOST=127.0.0.1
